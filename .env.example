# ============================================================================
# .env.example — Edge Function environment variables (ArchPrep PH Platform v2)
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is git-ignored and is NEVER
# deployed with the static site.
#
#   Local:      supabase start   (the CLI loads ./.env for served functions)
#   Deployed:   supabase secrets set --env-file .env
#
# Every value below is a PLACEHOLDER. The repository contains zero real keys,
# salts, or SMTP credentials (Requirement 28.3). The browser never sees any of
# them — the only public values live in config.js (Requirement 28.2).
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Dashboard: Project Settings → API. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are injected automatically into deployed Edge Functions; they are listed here
# for local function serving and for the seed/import scripts in supabase/seed/.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Dashboard: Project Settings → API → service_role secret.
# Bypasses Row-Level Security. Server-side only, forever.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Dashboard: Project Settings → API → JWT Settings → JWT Secret.
# OPTIONAL. With it set, an Edge Function verifies a session token's HS256
# signature in-process, with no round trip. Left unset, the same verification
# happens against the project's own auth server instead, which is also the only
# path available to a project using asymmetric JWT signing keys. Either way the
# signature, the issuing project, and the expiry are all checked with zero clock
# tolerance (Requirement 4.1) — this value only changes where the check runs.
# SUPABASE_JWT_SECRET=replace-with-project-jwt-secret

# ---------------------------------------------------------------------------
# Browser origins allowed to call the Edge Functions (CORS)
# ---------------------------------------------------------------------------
# The front end is a static site on its own host, so every browser call to a
# function is cross-origin: the browser sends an OPTIONS preflight first and
# drops the real request unless the function answers with a matching
# `access-control-allow-origin`. List the site's origins here, comma separated,
# scheme included and no trailing path.
#
#   CORS_ALLOWED_ORIGINS=https://archprep.ph,https://www.archprep.ph
#
# Leave it unset for local development: the functions then allow
# http://localhost, http://127.0.0.1, and http://[::1] on any port, and nothing
# else. That default is deliberately not `*` — these responses are one student's
# data behind a bearer token, and a wildcard would let any page they visit read
# those responses using the token it can already see. A deployed function with
# this variable unset will refuse the live site on the first request, which is a
# loud failure at deploy time rather than a quietly permissive production
# setting. Setting the literal value `*` is possible but is an explicit choice.
CORS_ALLOWED_ORIGINS=https://YOUR-SITE-DOMAIN

# ---------------------------------------------------------------------------
# HitPay (Requirement 13)
# ---------------------------------------------------------------------------
# Dashboard: HitPay → Settings → Payment Gateway → API Keys → "API key".
# Sent as the X-BUSINESS-API-KEY header on payment-request calls.
HITPAY_API_KEY=replace-with-hitpay-business-api-key

# Dashboard: HitPay → Settings → Payment Gateway → API Keys → "Salt".
# Used for the HMAC-SHA256 signature check over the raw webhook body.
HITPAY_WEBHOOK_SALT=replace-with-hitpay-webhook-salt

# Sandbox: https://api.sandbox.hit-pay.com
# Live:    https://api.hit-pay.com
# Switching sandbox → live is a change of this value and the two keys above,
# with zero code changes (Requirement 13.7).
HITPAY_API_BASE_URL=https://api.sandbox.hit-pay.com

# ---------------------------------------------------------------------------
# Custom SMTP for Auth one-time-password email (Requirement 30.3)
# ---------------------------------------------------------------------------
# Set these in Dashboard: Project Settings → Authentication → SMTP Settings.
# Kept here so the required names are documented in one place. Any provider
# with a free tier works (for example Resend, Brevo, or Mailgun); credentials
# come from that provider's dashboard.
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_SENDER_EMAIL=login@your-domain.example
SMTP_SENDER_NAME=ArchPrep PH
SMTP_ADMIN_EMAIL=owner@your-domain.example

# ---------------------------------------------------------------------------
# Local test harness only (tests/helpers/clients.mjs, tests/helpers/tokens.mjs)
# ---------------------------------------------------------------------------
# The v2 test suites talk to a local `supabase start` stack and mint their own
# JWT variants (valid, expired, unsigned, foreign-issuer, and so on) so the
# Edge Function auth gate can be tested against tokens no real auth server
# would ever issue.
#
# Leave all three unset for normal local runs: the helpers fall back to the
# well-known local development values that every `supabase start` stack uses
# (documented in tests/helpers/tokens.mjs). Those defaults are local-only and
# grant nothing beyond 127.0.0.1. Set them only when pointing the suites at a
# non-default stack — and never commit a real value.
#
# SUPABASE_JWT_SECRET=      # local default: the standard supabase-start secret
# SUPABASE_ANON_KEY=        # local default: minted from SUPABASE_JWT_SECRET
# SUPABASE_URL=             # local default: http://127.0.0.1:54321
#
# Suites that need the stack running skip with a message when it is absent, so
# `npm test` stays green without Docker.
